# --- Supabase ---
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# À garder SECRET — ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- URL publique du site ---
NEXT_PUBLIC_SITE_URL=https://as-tu-lu.fr

# --- Emails transactionnels (compte Brevo de la plateforme) ---
# Brevo > SMTP & API > API Keys
PLATFORM_BREVO_API_KEY=xkeysib-...
PLATFORM_FROM_EMAIL=contact@as-tu-lu.fr
PLATFORM_FROM_NAME=As-tu-lu

# --- Liste Brevo des auteurs (compte de la plateforme) ---
# Brevo > Contacts > Listes > créer « Auteurs As-tu-lu » puis coller son ID.
# Distincte des listes lecteur, qui vivent dans le compte Brevo de chaque auteur.
PLATFORM_BREVO_AUTHORS_LIST_ID=

# --- Secret de signature des liens de désabonnement ---
# Chaîne aléatoire longue. Si absent, SUPABASE_SERVICE_ROLE_KEY est utilisé.
UNSUBSCRIBE_SECRET=

# --- Connexion Postgres directe (uniquement pour `npm run db:migrate`) ---
# Supabase > Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.xxxxxxx:MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
